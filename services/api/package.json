{
  "name": "@path-app/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/lib/auth/token.test.ts src/lib/api/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed.ts",
    "db:ping": "tsx src/db/ping.ts",
    "worker:captures": "tsx scripts/capture-worker.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
