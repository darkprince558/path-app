# Copy to services/gemini/.env (gitignored) or set these in the server environment.
# Never commit a real key.
GEMINI_API_KEY=replace-with-your-server-side-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
GEMINI_MAX_IMAGE_BYTES=5242880
# Set to 1 only when you intend to make a real, billable API call in tests.
RUN_LIVE_GEMINI_TESTS=0
