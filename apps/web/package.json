{
  "name": "@path-app/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/glb.test.ts && node --experimental-strip-types tests/places.test.ts && node --experimental-strip-types tests/scan-surfaces.test.ts && node --experimental-strip-types tests/navigation.test.mjs && node --experimental-strip-types tests/navmesh.test.mjs && node --experimental-strip-types tests/walk.test.ts",
    "test:navmesh:browser": "playwright test --config playwright.navmesh.config.ts",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "test:browser": "playwright test tests/navigation.browser.spec.ts --workers=1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recast-navigation": "^0.44.0",
    "sonner": "^2.0.8",
    "three": "^0.187.0",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
