# Copy this file to services/api/.env for the Stage 1 database commands.
# Use the Tiger Data PostgreSQL connection URI, including TLS settings from its dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Phase 2: Auth0 Next.js SDK v4; do not use these in browser code.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.not404.app
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Development-only local GLB storage. The API defaults to services/api/.local-scans.
SCAN_STORAGE_DIR=

# Phase 3: Vultr private Object Storage bucket, S3-compatible endpoint.
VULTR_OBJECT_STORAGE_ENDPOINT=https://YOUR_ENDPOINT.vultrobjects.com
VULTR_OBJECT_STORAGE_REGION=
VULTR_OBJECT_STORAGE_BUCKET=
VULTR_OBJECT_STORAGE_ACCESS_KEY_ID=
VULTR_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Phase 6: Google GenAI SDK, server-side only.
GEMINI_API_KEY=
